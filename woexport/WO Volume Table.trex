<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.keysight.kgso.wovolumetable" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Renders the work-order volume table with per-column filters, search, paging and export to Excel with real dates and numbers.</description>
    <author name="Global Ops TAT and SOT Performance team" email="noreply@keysight.com" organization="Keysight Technologies" website="https://www.keysight.com"/>
    <min-api-version>1.10</min-api-version>
    <source-location>
      <url>https://manoj-key.github.io/tat-export/wo-export/index.html</url>
    </source-location>
    <icon></icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">WO Volume Table</text>
    </resource>
  </resources>
</manifest>
